# Copy to backend/.env before: docker compose -f deploy/docker-compose.yml up
# DB_HOST must be the mysql service name from docker-compose.yml

APP_NAME=FI2T
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fi2t
DB_USERNAME=fi2t_user
DB_PASSWORD=fi2t_secret_change_me
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@fit-tunisie.org"
MAIL_FROM_NAME="${APP_NAME}"

FORM_NOTIFY_TO=
FORM_NOTIFY_CONTACT=
FORM_NOTIFY_NEWSLETTER=
FORM_NOTIFY_ADHESION=

SANCTUM_EXPIRATION=480
SANCTUM_STATEFUL_DOMAINS=localhost,yourdomain.tn

# First seed only — change after deploy
ADMIN_SEED_PASSWORD=change_me_strong_password
