# Copy to backend/.env on Prodexo — fill passwords from your personal acces doc (do not commit .env)

APP_NAME=FI2T
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://preprod2026.prodexo.agency/fi2t

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=fi2t-mysql
DB_PORT=3306
DB_DATABASE=fi2t
DB_USERNAME=fi2t_user
DB_PASSWORD=CHANGE_ME_fi2t_user_password

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@fit-tunisie.org
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_EXPIRATION=480
SANCTUM_STATEFUL_DOMAINS=preprod2026.prodexo.agency

ADMIN_SEED_PASSWORD=CHANGE_ME_before_first_seed
