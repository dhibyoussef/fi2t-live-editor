APP_NAME=FI2T
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production tip: set APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fi2t
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact.fi2t@fit-tunisie.org"
MAIL_FROM_NAME="FI2T"

# Brevo (preferred — HTTPS, no SMTP install on the server):
# MAIL_MAILER=brevo
# BREVO_KEY=

# Official From: (one per form). Receiver is FORM_RECEIVER until real mailboxes exist.
FORM_NOTIFY_CONTACT=contact.fi2t@fit-tunisie.org
FORM_NOTIFY_NEWSLETTER=newsletter.fi2t@fit-tunisie.org
FORM_NOTIFY_ADHESION=adhesion.fi2t@fit-tunisie.org
FORM_RECEIVER=
# Must be a sender already verified in Brevo (Senders). Until fit-tunisie.org
# is authenticated, use the Brevo account email — unofficial From is rejected.
BREVO_SENDER=

# Optional — raises MyMemory daily quota for auto-translate (FR/EN/AR)
# MYMEMORY_EMAIL=you@example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum personal-access-token expiry (minutes). Per-token expires_at still wins when set.
SANCTUM_EXPIRATION=480

# Only used the first time AdminSeeder creates accounts — never overwrites existing passwords.
# Change this before first seed on a real server, then change passwords in the admin UI.
ADMIN_SEED_PASSWORD=
